{
  "entities": {
    "app_sync": {
      "path": "app_sync/{docId}",
      "description": "Global synchronized state for clients, deposits, withdrawals, trades, chats, and admin configurations",
      "fields": {
        "users": { "type": "array", "description": "List of registered clients and their account balances" },
        "adminConfig": { "type": "map", "description": "Admin brokerage configurations and wallets" },
        "withdrawals": { "type": "array", "description": "Withdrawal requests and audit status" },
        "ledger": { "type": "array", "description": "Financial ledger transactions" },
        "chats": { "type": "array", "description": "Bolt support chat messages" },
        "trades": { "type": "array", "description": "Active and closed trades" },
        "updatedAt": { "type": "string", "description": "Last synchronization timestamp" }
      }
    }
  }
}
